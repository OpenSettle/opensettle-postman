{
  "info": {
    "name": "OpenSettle API",
    "description": "Hand-curated collection covering the OpenSettle v1 public API.\n\nSpec source of truth: https://api.opensettle.io/v1/openapi.json\n\nUsage:\n1. Import this collection + `OpenSettle.postman_environment.json`.\n2. Fill in `apiOrigin`, `apiKey`, `workspaceId` in the environment.\n3. As you create resources, copy the IDs into the matching environment\n   variables (`customerId`, `invoiceId`, `priceId`, etc).\n\nEvery mutating request includes `Idempotency-Key: {{$guid}}` — Postman\ngenerates a fresh UUID per send, so retries from the UI are safe.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "00000000-0000-0000-0000-000000000002"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{apiKey}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "customerId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "checkoutId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "priceId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "walletId", "value": "" },
    { "key": "endpointId", "value": "" },
    { "key": "deliveryId", "value": "" }
  ],
  "item": [
    {
      "name": "Me",
      "item": [
        {
          "name": "Get current session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiOrigin}}/v1/me",
              "host": ["{{apiOrigin}}"],
              "path": ["v1", "me"]
            },
            "description": "Returns the authenticated session/key context. Use as a sanity check that `apiKey` is set correctly."
          }
        }
      ]
    },
