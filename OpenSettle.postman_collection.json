        },
        {
          "name": "Create invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"chain\": \"base\",\n  \"token\": \"USDC\",\n  \"lineItems\": [\n    {\n      \"description\": \"Pro plan – 1 month\",\n      \"quantity\": 1,\n      \"unitAmountMinor\": 19900\n    }\n  ],\n  \"dueInDays\": 14,\n  \"memo\": \"Thanks for your business\",\n  \"metadata\": { \"orderId\": \"ord_123\" }\n}"
            },
            "url": {
              "raw": "{{apiOrigin}}/v1/workspaces/{{workspaceId}}/invoices",
              "host": ["{{apiOrigin}}"],
              "path": ["v1", "workspaces", "{{workspaceId}}", "invoices"]
            },
            "description": "Required fields: customerId, chain, token, lineItems[]. `currency` defaults to USD; `dueInDays` defaults to 14. Top-level `amountMinor` is NOT a field — totals are derived from `lineItems[].unitAmountMinor * quantity`."
          }
        },
